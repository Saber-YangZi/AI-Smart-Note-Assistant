# ============================================================
# AI 智能笔记助手 - 后端环境变量样例
# 复制为 .env 后按需填写；CI 用占位值即可跑纯单元测试（不连库/GPU）
# ============================================================

# ── 认证 / 安全 ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ENV=development

# ── MySQL（聊天历史持久化）────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chat_history

# ── Redis ────────────────────────────────────────────────────
# 注：app/db/redis_config.py 当前为硬编码 (localhost:6379 db=3)，未走环境变量

# ── 用户服务 Django（认证校验）────────────────────────────────
# 业务态填真实地址（如 http://127.0.0.1:8001）；纯单测可留空
DJANGO_API_URL=http://127.0.0.1:8001

# ── 大模型 / 向量 / 视觉，二选多：OLLAMA / VLLM / 阿里云 DashScope / GLM ──
# LLM_TYPE: ollama | vllm | aliyun | glm
LLM_TYPE=glm
# -- 阿里云 DashScope / 通义 --
ALIYUN_ACCESS_KEY_SECRET=your_dashscope_api_key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_NAME=qwen-plus
CHAT_MODEL_NAME=qwen-plus
TEXT_EMBEDDING_MODEL_NAME=text-embedding-v3
EMBED_MODEL_TYPE=aliyun
ALIYUN_EMBED_MODEL_NAME=text-embedding-v3
VISION_MODEL_TYPE=aliyun
VISION_CHAT_MODEL_NAME=qwen-vl-max
# -- GLM (智谱) --
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_CHAT_MODEL=glm-4-air
GLM_EMBED_MODEL=embedding-2
GLM_VISION_MODEL=glm-4v-flash
# -- Ollama 本地 --
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b
OLLAMA_CHAT_MODEL_NAME=qwen2.5:7b
# -- vLLM 本地 --
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# -- 遇到导入报错时显式指定 torch 设备 --
# TORCH_DEVICE=cpu

# ── 向量库 / Rerank ──────────────────────────────────────────
# VECTOR_STORE_TYPE: qdrant(local) | chroma（默认 qdrant，本地持久化目录）
VECTOR_STORE_TYPE=qdrant
QDRANT_PATH=./qdrant
QDRANT_COLLECTION=test
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBED_MODEL_PATH=./models/bge-m3

# ── RAG 运行参数 ─────────────────────────────────────────────
RAG_TIMEOUT_HYDE=30
RAG_TIMEOUT_FAST=30
RAG_TIMEOUT_GENERATE=120
RAG_USE_HYDE=false
RATE_LIMIT_ENABLED=false
KB_ADMIN_USERS=test

# ── OCR / 视觉解构（PDF 图片型）───────────────────────────────
OCR_DEVICE=cpu
OCR_DEDUP_THRESHOLD=0.95
VISION_DEDUP_ENABLED=true

# ── MEMORY 摘要 ─────────────────────────────────────────────
MEMORY_SUMMARY_TRIGGER_TURNS=20
MEMORY_KEEP_RECENT_TURNS=6
MEMORY_SUMMARY_MAX_TURN_CHARS=2000

# ── 共享知识库（图片型 PDF 抽取图片存盘）──────────────────────
# SHARED_KB_USER=test